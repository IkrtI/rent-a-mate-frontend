# Example only: set these values in your production build/deployment environment.
# Next.js does not load .env.production.example automatically. Do not commit real secrets.
# NEXT_PUBLIC_* values are embedded in browser JavaScript at `next build` time;
# changing them requires a new frontend build (including when building Docker images).
# When using Docker, pass BACKEND_URL and every NEXT_PUBLIC_* value as build
# arguments; setting them only on a running container will not update the UI.

# Server-side NestJS REST API URL, including /api/v1. It must be reachable
# from the Next.js server/build environment, not necessarily from the browser.
BACKEND_URL=https://api.example.com/api/v1

# Public HTTPS origin of the frontend, with no trailing slash. Used for
# metadata URLs and same-origin checks on authenticated POST routes.
NEXT_PUBLIC_APP_URL=https://app.example.com

# Optional override if a trusted reverse proxy forwards an internal host.
# If unset, NEXT_PUBLIC_APP_URL is used for the same-origin check.
APP_ORIGIN=https://app.example.com

# Stripe publishable LIVE key only; never place sk_live or whsec here.
# Set this during `next build` so the Payment Element is available.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# Production must use Stripe, not the local no-charge mock UI.
NEXT_PUBLIC_PAYMENTS_MODE=stripe

# Browser-reachable HTTPS origin of the Socket.IO backend (no /api/v1 or /chat).
# Socket.IO upgrades this to WSS; authentication uses short-lived tickets.
NEXT_PUBLIC_SOCKET_URL=https://api.example.com

# HTTPS-only HttpOnly session cookies. Keep true behind a TLS-terminating proxy.
SESSION_COOKIE_SECURE=true
