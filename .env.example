# Server-only NestJS API base URL, including the API version prefix.
BACKEND_URL=http://localhost:3000/api/v1

# Public application origin used for canonical URLs and safe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Stripe publishable key only. Never put STRIPE_SECRET_KEY in this app.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Public Socket.IO backend origin. Auth uses ephemeral tickets, not browser JWT access.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Must be true in production.
SESSION_COOKIE_SECURE=false
